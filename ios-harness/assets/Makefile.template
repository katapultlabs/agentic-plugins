# iOS Harness — Makefile
# Drop this into your Xcode project root and edit the variables below.
# Requires: scripts/ directory from the ios-harness plugin (copy it into your project).
#
# Usage:
#   make build          Build with strict Swift 6 flags
#   make test           Run unit tests
#   make run            Launch on simulator (or macOS)
#   make build-and-run  Build then launch
#   make diagnose       Print build config and tool status
#   make clean          Remove current agent's build artifacts
#   make clean-all      Remove all build artifacts
#   make help           Show this list

# ─── Project config (edit these) ────────────────────────────────────────────
APP_NAME      := MyApp
PLATFORM      := ios
# Options: ios, macos

# Scheme name (defaults to APP_NAME; override if your scheme differs)
SCHEME        ?= $(APP_NAME)

# Override to target a specific simulator (default: auto-pick best)
SIM_NAME      ?= auto

# Build configuration
CONFIGURATION ?= Debug

# ─── Paths ──────────────────────────────────────────────────────────────────
# Points to the scripts/ directory copied from the ios-harness plugin.
SCRIPTS_DIR   := ./scripts

# ─── Derived values (usually don't touch) ───────────────────────────────────

# Auto-detect workspace or project (use shell to handle spaces in names)
WORKSPACE = $(shell ls -d *.xcworkspace 2>/dev/null | head -1)
PROJECT   = $(shell ls -d *.xcodeproj 2>/dev/null | head -1)

# Prefer workspace over project
BUILD_FILE = $(if $(WORKSPACE),-workspace "$(WORKSPACE)",$(if $(PROJECT),-project "$(PROJECT)",))

# Agent name (lazy — resolved on first use)
ifeq ($(origin AGENT_NAME), undefined)
  AGENT_NAME = $(shell \
    if [ -f agents/current_name.txt ]; then \
      tr -d '\n\r' < agents/current_name.txt; \
    else \
      echo CLAUDE; \
    fi)
endif

# ─── Strict build flags ────────────────────────────────────────────────────
STRICT_FLAGS := \
  GCC_TREAT_WARNINGS_AS_ERRORS=YES \
  SWIFT_TREAT_WARNINGS_AS_ERRORS=YES \
  SWIFT_STRICT_CONCURRENCY=complete \
  SWIFT_VERSION=6.0

# ─── Targets ────────────────────────────────────────────────────────────────
.DEFAULT_GOAL := build-and-run
.PHONY: help diagnose build test run build-and-run clean clean-all

help:
	@echo "iOS Harness targets:"
	@echo "  make build          Build with strict Swift 6 flags"
	@echo "  make test           Run unit tests"
	@echo "  make run            Launch app (assumes prior build)"
	@echo "  make build-and-run  Build then launch"
	@echo "  make diagnose       Print build config and tool status"
	@echo "  make clean          Remove current agent's build artifacts"
	@echo "  make clean-all      Remove all build artifacts"

diagnose:
	@echo "=== Build Configuration ==="
	@echo "  App:           $(APP_NAME)"
	@echo "  Scheme:        $(SCHEME)"
	@echo "  Platform:      $(PLATFORM)"
	@echo "  Configuration: $(CONFIGURATION)"
	@echo "  Workspace:     $(WORKSPACE)"
	@echo "  Project:       $(PROJECT)"
	@echo "  Build file:    $(BUILD_FILE)"
	@echo "  Agent:         $(AGENT_NAME)"
	@echo "  DerivedData:   build/DerivedData/$(AGENT_NAME)/"
	@echo "  Logs:          build/logs/$(AGENT_NAME)/"
	@echo ""
	@bash $(SCRIPTS_DIR)/doctor.sh

# Resolve destination inside recipes (not at parse time) to avoid running
# resolve-sim.sh for targets that don't need it (help, diagnose, clean).
define RESOLVE_DESTINATION
$(if $(filter ios,$(PLATFORM)),\
  $$(bash $(SCRIPTS_DIR)/resolve-sim.sh --name "$(SIM_NAME)"),\
  platform=macOS$(comma)arch=$$(uname -m))
endef
comma := ,

build:
	@DEST=$(RESOLVE_DESTINATION) && \
	AGENT_NAME="$(AGENT_NAME)" bash $(SCRIPTS_DIR)/xcbuild.sh \
	  --agent "$(AGENT_NAME)" --action build -- \
	  $(BUILD_FILE) \
	  -scheme "$(SCHEME)" \
	  -destination "$$DEST" \
	  -configuration $(CONFIGURATION) \
	  $(STRICT_FLAGS)

test:
	@DEST=$(RESOLVE_DESTINATION) && \
	AGENT_NAME="$(AGENT_NAME)" bash $(SCRIPTS_DIR)/xcbuild.sh \
	  --agent "$(AGENT_NAME)" --action test -- \
	  $(BUILD_FILE) \
	  -scheme "$(SCHEME)" \
	  -destination "$$DEST" \
	  -configuration $(CONFIGURATION) \
	  $(STRICT_FLAGS) \
	  test

run:
ifeq ($(PLATFORM),ios)
	@set -e; \
	echo "Launching $(APP_NAME) on iOS Simulator..."; \
	DERIVED="build/DerivedData/$(AGENT_NAME)"; \
	APP_PATH=$$(find "$$DERIVED" -name "$(APP_NAME).app" -path "*/$(CONFIGURATION)-iphonesimulator/*" 2>/dev/null | head -1); \
	if [ -z "$$APP_PATH" ]; then echo "ERROR: .app not found. Run 'make build' first." >&2; exit 1; fi; \
	DEST=$$(bash $(SCRIPTS_DIR)/resolve-sim.sh --name "$(SIM_NAME)"); \
	SIM_UDID=$$(echo "$$DEST" | sed 's/.*id=//'); \
	xcrun simctl boot "$$SIM_UDID" 2>/dev/null || true; \
	xcrun simctl bootstatus "$$SIM_UDID" -b 2>/dev/null || true; \
	open -a Simulator 2>/dev/null || true; \
	BUNDLE_ID=$$(/usr/libexec/PlistBuddy -c "Print:CFBundleIdentifier" "$$APP_PATH/Info.plist" 2>/dev/null); \
	xcrun simctl install "$$SIM_UDID" "$$APP_PATH" && \
	xcrun simctl launch "$$SIM_UDID" "$$BUNDLE_ID" && \
	echo "Launched $$BUNDLE_ID on $$SIM_UDID"
else
	@set -e; \
	echo "Launching $(APP_NAME) on macOS..."; \
	DERIVED="build/DerivedData/$(AGENT_NAME)"; \
	APP_PATH=$$(find "$$DERIVED" -name "$(APP_NAME).app" -path "*/$(CONFIGURATION)/*" ! -path "*Simulator*" 2>/dev/null | head -1); \
	if [ -z "$$APP_PATH" ]; then echo "ERROR: .app not found. Run 'make build' first." >&2; exit 1; fi; \
	open -n "$$APP_PATH"
endif

build-and-run: build run

clean:
	@bash $(SCRIPTS_DIR)/clean.sh --agent "$(AGENT_NAME)"

clean-all:
	@bash $(SCRIPTS_DIR)/clean.sh --all
